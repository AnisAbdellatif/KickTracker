# Copy to wrangler.toml (git-ignored) and fill in the hostnames, then
# `npx wrangler deploy` from this folder (README.md).
name = "kicktracker-ingress"
main = "src/worker.js"
compatibility_date = "2026-09-01"
# Never add global_fetch_strictly_public: the Worker reaches the main VPS
# through its own hostname, which that flag would send back to the Worker.

# The hostname Kick sends webhooks to (the one in the Kick app's settings).
routes = [
  { pattern = "<ingress host>/*", zone_name = "<domain>" },
]

[vars]
# The shadow machine's backup receiver: its Cloudflare Tunnel hostname.
BACKUP_URL = "https://<backup ingress host>"
# The main VPS: by default the route's own hostname (to its origin).
# MAIN_URL = "https://<ingress host>"
MAIN_TIMEOUT_MS = "5000"
BACKUP_TIMEOUT_MS = "10000"
