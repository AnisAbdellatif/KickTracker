# The bundled Caddy (compose profile "caddy"), for a VPS with no web server
# of its own: HTTPS for the site and the webhook ingress (project.md §15).
# Hosts and the admin allowlist come from secrets/stack.env; the sites
# themselves are in caddy/sites.caddy, shared with a host's own Caddy.
{
	email {$ACME_EMAIL}
}

import /etc/caddy/sites.caddy {$SITE_HOST} {$INGRESS_HOST} web-a:4100 web-b:4100 receiver-1:4060 receiver-2:4060 {$ADMIN_ALLOW:127.0.0.1/32}
