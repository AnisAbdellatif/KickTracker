#!/usr/bin/env bash
# The registry token Kamal logs the server in with (.kamal/secrets): a
# GitHub token with read:packages only, kept encrypted in
# deploy/secrets/deployer.sops.env (GHCR_READ_TOKEN). KT_REGISTRY_PASSWORD
# overrides it (the sandbox's local registry, .kamal/sandbox/sandbox.env).
set -euo pipefail
if [ -n "${KT_REGISTRY_PASSWORD:-}" ]; then
  printf '%s\n' "$KT_REGISTRY_PASSWORD"
else
  cd "$(dirname "$0")/../.."
  exec .kamal/kit/bin/kit sops get deploy/secrets/deployer.sops.env GHCR_READ_TOKEN
fi
