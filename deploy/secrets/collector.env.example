# The collectors (project.md §10.1). Only what collecting needs: no web
# secrets (SECRET_KEY_BASE). COLLECTOR_ID is set per service in compose.
DATABASE_URL=ecto://kick_tracker:CHANGE_ME@db/kick_tracker
POOL_SIZE=10
# One cluster for all app containers (web and collectors), so live
# readings reach the site: the same cookie in app.env and collector.env.
DNS_CLUSTER_QUERY=app
RELEASE_COOKIE=CHANGE_ME_A_LONG_RANDOM_STRING
# For the User-Agent sent to Kick (§18.3) and alert messages.
SITE_NAME=Stream Tracker
PHX_HOST=stats.example.org
CONTACT_EMAIL=privacy@example.org

# Kick (AGENTS.md §6): every URL and key from here.
KICK_API_URL=https://api.kick.com
KICK_ID_URL=https://id.kick.com
KICK_V2_URL=https://kick.com/api/v2
PUSHER_URL=wss://ws-us2.pusher.com/app/CHANGE_ME?protocol=7&client=js&version=8.4.0&flash=false
KICK_CLIENT_ID=CHANGE_ME
KICK_CLIENT_SECRET=CHANGE_ME
# KICK_PUBLIC_KEY=  (fetched from the API when unset)

# The shadow collector's database, read-only (shadow/readers.sql), over the
# private network: our gaps are filled from it (§10.5). Optional.
SHADOW_DATABASE_URL=
BACKFILL_DAYS=7

# RabbitMQ: the consumer; dead letters and queue depth for the alerts.
AMQP_URL=amqp://app:CHANGE_ME@rabbitmq:5672
DEAD_LETTERS_AMQP_URL=amqp://ops:CHANGE_ME@rabbitmq:5672
RABBITMQ_MANAGEMENT_URL=http://monitor:CHANGE_ME@rabbitmq:15672

# Alerts (§18.2), all optional. NTFY_URL is a topic's URL
# (https://<ntfy host>/<topic>); NTFY_TOKEN, for a server that requires one,
# a token of a user allowed only to write to that topic. HEARTBEAT_URL is
# pinged every minute by the collecting node: set it, so a dead collector
# is noticed from outside.
ALERT_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NTFY_URL=
NTFY_TOKEN=
HEARTBEAT_URL=
