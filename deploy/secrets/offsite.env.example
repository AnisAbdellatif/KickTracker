# The off-VPS copy of the backups (project.md §18.1): backup/offsite-sync.sh
# mirrors the `backups` volume (WAL-G's store, already encrypted) to Filen
# with rclone, and the weekly restore test restores from that copy.
#
# Use a Filen account of its own, holding nothing else: these credentials
# can read and delete everything in the account.
#
# The password and the API key are rclone-obscured, not plain:
#   docker run --rm rclone/rclone:1.75.1 obscure '<password>'
# The API key comes from the Filen CLI, logged in to that account:
#   docker run --rm -it filen/cli:0.2.9 export-api-key
# then obscured the same way. Changing the account's password changes the
# API key: export it again.
RCLONE_CONFIG_FILEN_TYPE=filen
RCLONE_CONFIG_FILEN_EMAIL=CHANGE_ME
RCLONE_CONFIG_FILEN_PASSWORD=CHANGE_ME
RCLONE_CONFIG_FILEN_API_KEY=CHANGE_ME
# The folder in the Filen drive the store is mirrored to.
OFFSITE_PATH=kicktracker-backups

# Pinged after each successful sync (every 5 minutes): set it at an
# external check that alerts when pings stop (e.g. healthchecks.io, with a
# period of 5 minutes and a grace of 15).
OFFSITE_HEARTBEAT_URL=
