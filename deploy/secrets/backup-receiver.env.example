# The backup webhook receiver on the shadow machine
# (deploy/kamal/backup-receiver.yml; ingress/receiver/README.md).
PORT=4060
# The main VPS's RabbitMQ over Tailscale: its private address (PRIVATE_IP
# in its deploy/.env), the publish-only `receiver` user.
AMQP_URL=amqp://receiver:CHANGE_ME@MAIN_PRIVATE_IP:5672
KICK_API_URL=https://api.kick.com
# KICK_PUBLIC_KEY=  (fetched from the API when unset)
