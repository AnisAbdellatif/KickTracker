# The shadow collectors (project.md §10.5), on the second machine.
DATABASE_URL=ecto://kick_tracker:CHANGE_ME@db/kick_tracker
POOL_SIZE=10
# The primary side's database, read-only (shadow/readers.sql), over the
# private network: the channel list and removal requests.
MAIN_DATABASE_URL=ecto://shadow_reader:CHANGE_ME@MAIN_PRIVATE_IP:5432/kick_tracker
SHADOW_KEEP_DAYS=30
SITE_NAME=Stream Tracker
PHX_HOST=stats.example.org
CONTACT_EMAIL=privacy@example.org

# Kick: its own app (register a second one on kick.com), so the shadow's
# token and rate limits don't depend on the primary's.
KICK_API_URL=https://api.kick.com
KICK_ID_URL=https://id.kick.com
KICK_V2_URL=https://kick.com/api/v2
PUSHER_URL=wss://ws-us2.pusher.com/app/CHANGE_ME?protocol=7&client=js&version=8.4.0&flash=false
KICK_CLIENT_ID=CHANGE_ME
KICK_CLIENT_SECRET=CHANGE_ME

# The shadow notifies when it can't reach the primary side (the primary's
# own alerts may be down with it). HEARTBEAT_URL: a separate check from the
# primary's, so the shadow dying is noticed too.
ALERT_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
HEARTBEAT_URL=
