POSTGRES_USER=kick_tracker
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=kick_tracker

# Backups with WAL-G to object storage off the VPS (project.md §18.1):
# Backblaze B2, Cloudflare R2 or S3 through the S3 API.
WALG_S3_PREFIX=s3://CHANGE_ME-bucket/kick_tracker
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_ENDPOINT=https://CHANGE_ME
AWS_REGION=auto
AWS_S3_FORCE_PATH_STYLE=true
# Encrypts backups at rest: 32 random bytes, hex (openssl rand -hex 32).
WALG_LIBSODIUM_KEY=CHANGE_ME
WALG_LIBSODIUM_KEY_TRANSFORM=hex
WALG_COMPRESSION_METHOD=zstd
