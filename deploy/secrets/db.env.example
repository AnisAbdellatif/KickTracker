POSTGRES_USER=kick_tracker
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=kick_tracker

# Backups with WAL-G (project.md §18.1) to /backups, the `backups` volume,
# which backup/offsite-sync.sh copies to Filen every 5 minutes (its
# settings: offsite.env). WAL-G could write to S3-compatible storage
# instead (WALG_S3_PREFIX, AWS_*); the scripts work with either.
WALG_FILE_PREFIX=/backups
# Encrypts backups before they're written, so on the VPS and on Filen:
# 32 random bytes, hex (openssl rand -hex 32). Keep a copy off the VPS:
# without it no backup can be read.
WALG_LIBSODIUM_KEY=CHANGE_ME
WALG_LIBSODIUM_KEY_TRANSFORM=hex
WALG_COMPRESSION_METHOD=zstd

# The backup scripts (backup/*.sh, run from cron) read their settings here
# too. Pinged after each successful base backup (daily) and restore test
# (weekly): set each at an external check that alerts when pings stop.
BACKUP_HEARTBEAT_URL=
RESTORE_HEARTBEAT_URL=
