#!/bin/sh
# The app's nodes form one cluster (project.md §9, §10), so the collector's
# live readings reach the pages served by web nodes over PubSub.
# DNSCluster finds the others by DNS_CLUSTER_QUERY (in compose, a network
# alias every app container shares); each node is named after its IP. The
# cookie (RELEASE_COOKIE) comes from the secrets, the same for all of them,
# so nodes built from different images still connect.
if [ -n "${DNS_CLUSTER_QUERY:-}" ]; then
  export RELEASE_DISTRIBUTION=name
  export RELEASE_NODE="<%= @release.name %>@$(hostname -i | awk '{print $1}')"
fi
