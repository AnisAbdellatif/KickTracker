<!DOCTYPE html>
<html lang={KickTrackerWeb.Layouts.html_lang()} dir={KickTrackerWeb.Layouts.html_dir()}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta name="description" content={KickTrackerWeb.Layouts.description(assigns)} />
    <meta property="og:site_name" content={KickTrackerWeb.Layouts.site_name()} />
    <meta property="og:type" content="website" />
    <meta
      property="og:title"
      content={assigns[:page_title] || KickTrackerWeb.Layouts.site_name()}
    />
    <meta property="og:description" content={KickTrackerWeb.Layouts.description(assigns)} />
    <meta
      :if={assigns[:conn]}
      property="og:url"
      content={Phoenix.Controller.current_url(@conn)}
    />
    <.live_title
      default={KickTrackerWeb.Layouts.site_name()}
      suffix={" · " <> KickTrackerWeb.Layouts.site_name()}
      phx-no-format
    >{assigns[:page_title]}</.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="module" src={~p"/assets/js/app.js"}>
    </script>
    <script nonce={assigns[:conn] && @conn.assigns[:csp_nonce]}>
      (() => {
        // Dark until the visitor picks light or "system" (project.md §13.7);
        // "system" is stored too, so a remembered choice is never lost.
        // Storage can be unavailable (private windows, blocked site data):
        // the theme is then dark and nothing is remembered.
        const stored = () => { try { return localStorage.getItem("phx:theme"); } catch (_e) { return null; } };
        const store = (theme) => {
          try {
            if (theme) localStorage.setItem("phx:theme", theme);
            else localStorage.removeItem("phx:theme");
          } catch (_e) {}
        };
        const systemTheme = () => matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        const root = document.documentElement;

        // Which of the toggle's buttons is the current choice.
        const sync = () => {
          const current = root.getAttribute("data-theme-source") === "system" ? "system" : root.getAttribute("data-theme");
          document.querySelectorAll("[data-phx-theme]").forEach((b) =>
            b.setAttribute("aria-pressed", String(b.dataset.phxTheme === current)));
        };

        const setTheme = (theme) => {
          if (theme === "system") {
            store("system");
            root.setAttribute("data-theme", systemTheme());
            root.setAttribute("data-theme-source", "system");
          } else {
            store(theme);
            root.setAttribute("data-theme", theme);
            root.setAttribute("data-theme-source", "user");
          }
          sync();
        };
        if (!root.hasAttribute("data-theme")) {
          const initial = stored();
          if (initial) {
            setTheme(initial);
          } else {
            root.setAttribute("data-theme", "dark");
            root.setAttribute("data-theme-source", "default");
            sync();
          }
        }
        window.addEventListener("storage", (e) => e.key === "phx:theme" && e.newValue && setTheme(e.newValue));
        window.addEventListener("phx:set-theme", (e) => setTheme(e.target.dataset.phxTheme));
        window.addEventListener("DOMContentLoaded", sync);
        window.addEventListener("phx:page-loading-stop", sync);

        matchMedia("(prefers-color-scheme: dark)").addEventListener("change", (e) => {
          if (root.getAttribute("data-theme-source") === "system") {
            root.setAttribute("data-theme", systemTheme());
          }
        });
      })();
    </script>
  </head>
  <body>
    {@inner_content}
  </body>
</html>
