<Layouts.app flash={@flash} wide={false} active={:about}>
  <article class="space-y-4 text-sm leading-relaxed">
    <h1 class="text-2xl font-semibold">{gettext("Removal requests")}</h1>
    <p>
      {gettext(
        "If you stream on Kick and don't want your channel here, write to %{contact} from an address we can connect to the channel (or send the request from the channel itself, for instance in its bio or a chat message we can see). Tell us which of these you'd like:",
        contact: contact()
      )}
    </p>
    <ul id="removal-options" class="list-disc ps-5 space-y-2">
      <li>
        <span class="font-semibold">{gettext("Hidden.")}</span>
        {gettext(
          "The channel disappears from this site and from the data we share with other applications. What we collected is kept, so it can come back if you change your mind."
        )}
      </li>
      <li>
        <span class="font-semibold">{gettext("Live only.")}</span>
        {gettext(
          "The site shows only whether you are live, with how many are watching and chatting at the moment. Your history (past streams, followers, subs, categories) is neither shown nor shared."
        )}
      </li>
      <li>
        <span class="font-semibold">{gettext("Deleted.")}</span>
        {gettext(
          "We stop tracking the channel and delete everything we collected about it. This can't be undone."
        )}
      </li>
    </ul>
    <p>{gettext("We'll reply to say what we did.")}</p>
    <p>
      {gettext("If you're in a channel's audience and want your data removed, see")} <.link
        navigate={~p"/about/privacy"}
        class="link"
      >{gettext("privacy")}</.link>.
    </p>
  </article>
</Layouts.app>
