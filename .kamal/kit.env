# deploy-kit settings for KickTracker (committed). Every setting and its
# default: .kamal/kit/lib/defaults.sh; the kit's docs/configuration.md.
# The server itself (address, user, folder, smoke URLs, alert channels)
# goes in .kamal/kit.local.env (git-ignored; see kit.local.env.example).
#
# A release is deploy/release.sh: kit deploy of the app, then of the
# receivers (deploy/README.md, "Deploying a change").

# Kamal configs: the app's by default; the receivers' is their group's.
KIT_KAMAL_CONFIG_FILE=deploy/kamal/app.yml

# Images are built, labelled and attested by CI on main
# (.github/workflows/ci.yml); a deploy pulls them, never builds.
KIT_DEPLOY_SKIP_PUSH=true
KIT_IMAGE_KICKTRACKER=${KT_REGISTRY:-ghcr.io}/${KT_IMAGE_OWNER:-anisabdellatif}/kicktracker-app
KIT_IMAGE_KICKTRACKER_RECEIVER=${KT_REGISTRY:-ghcr.io}/${KT_IMAGE_OWNER:-anisabdellatif}/kicktracker-receiver
KIT_ATTESTATION_SIGNER_WORKFLOW=AnisAbdellatif/KickTracker/.github/workflows/ci.yml

# Gates, then the server brought up to the commit (checkout and secrets),
# then the migrations: all before any container is replaced. Nothing is
# built here, so pre-build has nothing to check.
KIT_DEPLOY_BRANCH=main
KIT_HOOK_PRE_BUILD=
KIT_HOOK_PRE_DEPLOY="freeze role-guard require-branch require-clean require-pushed ci-green attestation server-sync migrate notify"
KIT_CACHED_STEPS="require-branch require-clean require-pushed ci-green attestation confirm freeze server-sync migrate"
# Every check of the commit's CI run must have passed, the images included.
KIT_CI_WAIT=0

# Collectors first, then the site (release.sh deploys the receivers after).
KIT_GROUP_ORDER="collectors web"
