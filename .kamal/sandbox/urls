#!/usr/bin/env bash
# Where everything is (printed by `kit sandbox up` and `status`).
# shellcheck source=lib.sh
. "$(dirname "$0")/lib.sh"

mode=$(kick_mode 2>/dev/null || echo "?")
cat <<URLS

  The site            http://localhost:8080   (the admin: /admin)
  The ingress         http://127.0.0.1:8080   (webhooks, as Kick reaches it)
  Web nodes direct    http://127.0.0.1:4110  http://127.0.0.1:4111
URLS
if [ "$mode" = real ]; then
  echo "  Kick                the REAL one, through the sandbox's own Kick app (kick.env)"
else
  echo "  The fake Kick       http://127.0.0.1:4050/_sim/state"
fi
