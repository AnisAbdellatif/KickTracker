# The real Kick for the sandbox, opt-in (README.md here, "The real Kick").
# Copy to kick.env (git-ignored, never committed) and fill it in, then
# create the sandbox with KT_SANDBOX_KICK=real.
#
# Use a Kick app of the sandbox's own, never production's: webhook
# subscriptions belong to the app, and the sandbox's collector syncs them
# to what *it* tracks, removing the rest (it would unsubscribe
# production's channels). The secrets hook refuses production's client id.

KICK_API_URL=https://api.kick.com
KICK_ID_URL=https://id.kick.com
KICK_V2_URL=https://kick.com/api/v2
PUSHER_URL="wss://ws-us2.pusher.com/app/CHANGE_ME?protocol=7&client=js&version=8.4.0&flash=false"
KICK_CLIENT_ID=CHANGE_ME
KICK_CLIENT_SECRET=CHANGE_ME

# The channels to track once deployed (slugs, space separated); or leave
# empty and add them in the admin.
KT_SANDBOX_CHANNELS=""
