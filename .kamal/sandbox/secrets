#!/usr/bin/env bash
# Before the first deploy: the server's checkout (a copy of deploy/) with
# generated local secrets in place of the sops files production decrypts
# there, and RabbitMQ's definitions for them. Never a real secret: the Kick
# settings point at the fake Kick on this machine.
set -euo pipefail
# shellcheck source=lib.sh
. "$(dirname "$0")/lib.sh"

sync_deploy
secrets=$SERVER_DIR/secrets
[ -f "$secrets/app.env" ] && exit 0
mkdir -p "$secrets"
umask 077
rand() { head -c 256 /dev/urandom | base64 | tr -dc 'A-Za-z0-9' | head -c "${1:-32}"; }

db_pw=$(rand) app_pw=$(rand) receiver_pw=$(rand) ops_pw=$(rand) monitor_pw=$(rand) admin_pw=$(rand)
kick="KICK_API_URL=http://host.docker.internal:4050
KICK_ID_URL=http://host.docker.internal:4050
KICK_V2_URL=http://host.docker.internal:4050/api/v2
PUSHER_URL=ws://host.docker.internal:4050/app/32cbd69e4b950bf97679?protocol=7&client=js&version=8.4.0&flash=false
KICK_CLIENT_ID=sandbox
KICK_CLIENT_SECRET=sandbox"
common="DATABASE_URL=ecto://kick_tracker:$db_pw@db/kick_tracker
POOL_SIZE=10
DNS_CLUSTER_QUERY=app
RELEASE_COOKIE=$(rand 48)
SITE_NAME=Stream Tracker
PHX_HOST=localhost
CONTACT_EMAIL=ops@example.org
$kick
AMQP_URL=amqp://app:$app_pw@rabbitmq:5672
DEAD_LETTERS_AMQP_URL=amqp://ops:$ops_pw@rabbitmq:5672
RABBITMQ_MANAGEMENT_URL=http://monitor:$monitor_pw@rabbitmq:15672"

printf '%s\nSECRET_KEY_BASE=%s\n' "$common" "$(rand 64)" >"$secrets/app.env"
printf '%s\n' "$common" >"$secrets/collector.env"
printf 'PORT=4060\nAMQP_URL=amqp://receiver:%s@rabbitmq:5672\nKICK_API_URL=http://host.docker.internal:4050\n' \
  "$receiver_pw" >"$secrets/receiver.env"
printf 'POSTGRES_USER=kick_tracker\nPOSTGRES_PASSWORD=%s\nPOSTGRES_DB=kick_tracker\nWALG_FILE_PREFIX=/var/lib/postgresql/walg-store\nWALG_COMPRESSION_METHOD=zstd\n' \
  "$db_pw" >"$secrets/db.env"
# Plain HTTP on 127.0.0.1:8080 (compose.sandbox.yml): the site on
# localhost, the ingress on 127.0.0.1.
printf 'SITE_HOST=http://localhost\nINGRESS_HOST=http://127.0.0.1\nACME_EMAIL=ops@example.org\nADMIN_ALLOW=127.0.0.1/32\n' \
  >"$secrets/stack.env"

RABBITMQ_ADMIN_PASSWORD=$admin_pw RABBITMQ_RECEIVER_PASSWORD=$receiver_pw RABBITMQ_APP_PASSWORD=$app_pw \
  RABBITMQ_OPS_PASSWORD=$ops_pw RABBITMQ_MONITOR_PASSWORD=$monitor_pw "$SERVER_DIR/rabbitmq/make-prod-definitions.sh" >/dev/null
printf 'DB_IMAGE=%s\n' "$DB_IMAGE" >"$SERVER_DIR/.env"
