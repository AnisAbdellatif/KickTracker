# kit sandbox settings for KickTracker (committed): the production stack on
# this machine, deployed by the kit and Kamal as production is
# (deploy/README.md, "The sandbox"). Defaults and every setting: the kit's
# docs/sandbox.md.

# The app (collectors and web), then the receivers, as deploy/release.sh.
KIT_SANDBOX_CONFIGS="deploy/kamal/app.yml deploy/kamal/receiver.yml"

# What deploy/kamal/*.yml read from the environment, for the sandbox: its
# server, the checkout's place there (the secrets hook's copy of deploy/ is
# mounted at deploy/), volumes of their own (kicktracker-sandbox_*), images
# from the sandbox's registry (the migrate step and the registry password
# read these too; the local registry takes any password).
KIT_SANDBOX_ENV="KT_HOST=127.0.0.1 KT_SSH_USER=root KT_SSH_PORT=2222 KT_DEPLOY_DIR=/srv/kick_tracker KT_VOLUME_PREFIX=kicktracker-sandbox KT_REGISTRY=127.0.0.1:5555 KT_REGISTRY_PASSWORD=sandbox"
KIT_SANDBOX_SERVER_PATH=/srv/kick_tracker/deploy
KIT_SANDBOX_NAME=kicktracker

# Ports on 127.0.0.1. Caddy answers on 8080 (the site on localhost, the
# ingress on 127.0.0.1), the fake Kick on 4050. No role runs kamal-proxy.
# KIT_SANDBOX_SSH_PORT=2222
# KIT_SANDBOX_REGISTRY_PORT=5555
