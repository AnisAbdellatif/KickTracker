# deploy-kit for the deploy rehearsal (deploy/rehearsal/rehearse.sh):
# `kit … -d rehearsal`. Its "server" is a container on this machine with
# pre-made secrets and no git checkout, and its images come from a local
# registry: no git or CI gates, no server-sync; the rest as in production.
KIT_HOOK_PRE_DEPLOY="freeze role-guard migrate notify"
