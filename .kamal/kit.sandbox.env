# deploy-kit settings for the sandbox destination (kit sandbox,
# .kamal/sandbox/). The kit's own gates (branch, CI, attestation, freeze...)
# skip themselves in the sandbox; server-sync is left out (the sandbox's
# "checkout" is the secrets hook's copy of deploy/, with generated secrets).
# Migrations run as in production.
KIT_HOOK_PRE_DEPLOY="freeze role-guard migrate notify"

# Checked after each sandbox deploy, through Caddy (the project's other
# smoke URLs are production's, never used here). Only the site: the first
# deploy's app config goes out before the receivers exist.
KIT_SMOKE_URLS_SANDBOX="http://localhost:8080/healthz"
