# The collectors (project.md §10.1, §15.3): one collects, the other stands
# by. A deploy updates only the standby, waits until it's healthy, then
# hands collection over: the leader is restarted in place, on the build it
# has, and its clean stop releases the lease to the standby within a
# second. The old leader stays on the previous build as the standby, so
# rolling back is `kit group switch collectors` (a second's handover,
# nothing pulled), and the next deploy updates it.
KIT_GROUP_STRATEGY=standby
KIT_GROUP_ROLES="collector_a collector_b"
# Stopped before being replaced: never two containers on one journal.
KIT_GROUP_STOP_FIRST=true
# A new collector's first health check comes after its 30s start period.
KIT_GROUP_HEALTH_TIMEOUT=240
# The leader's clean stop takes up to its 60s stop timeout.
KIT_GROUP_SWITCH_TIMEOUT=120
KIT_GROUP_ON_SWITCH_FAILURE=report
