# The shadow collector (project.md §10.5) on the shadow machine: one role,
# replaced in place. Stopped first (its journal is its own), and put back
# on its previous build if the new one never gets healthy. Deployed with
# deploy/shadow.sh, never by release.sh (its config is shadow.yml).
KIT_GROUP_KAMAL_CONFIG_FILE=deploy/kamal/shadow.yml
KIT_GROUP_STRATEGY=rolling
KIT_GROUP_ROLES="shadow"
KIT_GROUP_STOP_FIRST=true
KIT_GROUP_RESTORE_ON_FAILURE=true
# A new collector's first health check comes after its 30s start period.
KIT_GROUP_HEALTH_TIMEOUT=240
