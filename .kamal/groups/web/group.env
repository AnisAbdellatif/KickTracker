# The two web nodes behind Caddy (§15.3), replaced one at a time: Caddy
# health-checks both every 2s, keeps a visitor on one and retries a
# request on the other while one is replaced. Each is stopped first (its
# loopback port can't be held by two containers); a node that fails its
# new build goes back to its previous one, and the other keeps serving.
KIT_GROUP_STRATEGY=rolling
KIT_GROUP_ROLES="web_a web_b"
KIT_GROUP_STOP_FIRST=true
KIT_GROUP_RESTORE_ON_FAILURE=true
KIT_GROUP_HEALTH_TIMEOUT=180
