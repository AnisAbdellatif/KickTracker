# The backup webhook receiver (project.md §15.2) on the shadow machine: one
# role, replaced in place (its port and spool are its own), put back on its
# previous build if the new one never gets healthy. Deployed with
# deploy/shadow.sh, never by release.sh (its config is backup-receiver.yml).
KIT_GROUP_KAMAL_CONFIG_FILE=deploy/kamal/backup-receiver.yml
KIT_GROUP_STRATEGY=rolling
KIT_GROUP_ROLES="receiver_backup"
KIT_GROUP_STOP_FIRST=true
KIT_GROUP_RESTORE_ON_FAILURE=true
KIT_GROUP_HEALTH_TIMEOUT=120
