# The two webhook receivers (§8.4, §15.3), their own image and Kamal
# config. Caddy sends webhooks to the first healthy one and fails over to
# the other within seconds, so they're replaced one at a time, each
# stopped first (its port and its spool are its own); one that fails its
# new build goes back to its previous one.
KIT_GROUP_KAMAL_CONFIG_FILE=deploy/kamal/receiver.yml
KIT_GROUP_STRATEGY=rolling
KIT_GROUP_ROLES="receiver_1 receiver_2"
KIT_GROUP_STOP_FIRST=true
KIT_GROUP_RESTORE_ON_FAILURE=true
KIT_GROUP_HEALTH_TIMEOUT=120
