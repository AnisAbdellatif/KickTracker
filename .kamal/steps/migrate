#!/usr/bin/env bash
# pre-deploy: migrations from the image being deployed, as a step of their
# own, before any of its containers starts (§15.3, expand-then-contract,
# lock_timeout 5s). Runs the app image with web's env file on the server
# (not `kamal app exec`, whose container would take web's published port).
# Only for the app image: the receiver has no database. On the shadow
# machine (deploy/shadow.sh), its own database.
# shellcheck source=/dev/null
. "$KIT_HOME/steps/_preamble.sh"
# shellcheck source=/dev/null
. "$KIT_HOME/lib/kamal.sh"

# shellcheck source-path=SCRIPTDIR source=_machine.sh
. "$(dirname "$0")/_machine.sh"

[ "${KAMAL_SERVICE:-}" = kicktracker ] || exit 0
image=$(kit_conf KIT_IMAGE_KICKTRACKER "")
[ -n "$image" ] || kit_die "KIT_IMAGE_KICKTRACKER isn't set (.kamal/kit.env)"
# The shadow machine's database is its own: migrated as the shadow
# collector, with its env file (deploy/kamal/shadow.yml).
if [ "$kt_machine" = shadow ]; then
  run="--env-file $kt_secrets/shadow.env -e ROLE=collector -e COLLECTOR_MODE=shadow"
else
  run="--env-file $kt_secrets/app.env -e ROLE=web"
fi
kit_kamal server exec -H -q -p \
  "docker run --rm --network kamal $run $image:${KAMAL_VERSION:?} /app/bin/migrate"
