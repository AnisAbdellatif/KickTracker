#!/usr/bin/env bash
# pre-deploy: the server's checkout up to the commit being deployed, and
# its secrets decrypted there (deploy/server-sync.sh), before any
# container starts. The app's secrets never pass through this machine.
# shellcheck source=/dev/null
. "$KIT_HOME/steps/_preamble.sh"
# shellcheck source=/dev/null
. "$KIT_HOME/lib/kamal.sh"

# shellcheck source-path=SCRIPTDIR source=_machine.sh
. "$(dirname "$0")/_machine.sh"

# Every host of the config deployed: the main VPS, or the shadow machine
# (deploy/shadow.sh), each with its own checkout.
kit_kamal server exec -H -q "cd $kt_dir && deploy/server-sync.sh ${KAMAL_VERSION:?}"
