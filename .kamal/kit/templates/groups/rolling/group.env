# A rolling group: interchangeable roles (e.g. two receivers behind your own
# load balancer, each on its own published port) updated one at a time,
# each healthy before the next, so one always serves. docs/groups.md.
#
# Roles behind Kamal's proxy don't need a group: the proxy already swaps
# them without downtime.

KIT_GROUP_STRATEGY=rolling
KIT_GROUP_ROLES="receiver_1 receiver_2"

# Published ports and per-role files can't be shared by the old and the new
# container: stop each before replacing it (the other one serves meanwhile).
KIT_GROUP_STOP_FIRST=true
KIT_GROUP_HEALTH_TIMEOUT=120

# A role that fails on the new build goes back to the one it ran, so it
# serves again (the roles already updated keep the new build).
KIT_GROUP_RESTORE_ON_FAILURE=true

# listed, or inactive-first (needs an `active` script: the idle ones first).
KIT_GROUP_ROLLING_ORDER=listed
