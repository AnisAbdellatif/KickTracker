# Copy to .kamal/kit.local.env (git-ignored) on each machine that deploys.
# kit exports these, so Kamal's configs (deploy/kamal/*.yml) read them too.
# To run `kamal` itself: set -a; . .kamal/kit.local.env; set +a

# Kamal: installed here (gem install kamal), or run in the kit's image
# with Docker (deploy-kit's docs/runner.md; needs only bash, git, Docker).
# KIT_RUNNER=docker

# The main VPS, its deploy user, and the checkout there.
KT_HOST=
KT_SSH_USER=
KT_DEPLOY_DIR=/srv/kick_tracker
# The shadow machine (deploy/README.md, "The shadow machine"): its
# Tailscale address, deploy user and checkout. Needed only where it's
# deployed from (deploy/shadow.sh, and on it, the follower).
KT_SHADOW_HOST=
KT_SHADOW_SSH_USER=
KT_SHADOW_DEPLOY_DIR=/srv/kick_tracker
# The follower (deploy/shadow-follow.sh), on the shadow machine only: how
# long a build must be live and healthy on the main VPS before it's
# deployed here, and where to check the main VPS.
# KT_SHADOW_SOAK=6h
# KT_FOLLOW_SITE_HEALTH=https://<site host>/healthz
# KT_FOLLOW_INGRESS_HEALTH=https://<ingress host>/health
# A read-only GHCR token (read:packages) for the registry login, where
# deployer.sops.env can't be decrypted (the shadow machine).
# KT_REGISTRY_PASSWORD=

# Checked from outside after each deploy, through Caddy; a failure rolls
# the deploy back.
KIT_SMOKE_URLS="https://<site host>/healthz https://<ingress host>/health"

# Where the kit's notifications go (the app's own alerts are configured in
# its secrets). Telegram, a webhook (Slack, Discord), or ntfy.
KIT_TELEGRAM_BOT_TOKEN=
KIT_TELEGRAM_CHAT_ID=
# ntfy: the topic's URL (https://<ntfy host>/<topic>), and a token for a
# server that requires one (a user allowed only to write to that topic).
KIT_NTFY_URL=
KIT_NTFY_TOKEN=
