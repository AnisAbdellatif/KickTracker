# Copy to .env (git-ignored) and fill in. Used only by the recorder tasks.

# From your app on kick.com (developer settings).
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# Optional: added to our User-Agent so Kick can reach us, e.g. an email.
KICK_CONTACT=

# Endpoints. Defaults are the real Kick; leave commented unless testing.
# KICK_API_URL=https://api.kick.com
# KICK_ID_URL=https://id.kick.com
# KICK_V2_URL=https://kick.com/api/v2
# PUSHER_URL=wss://ws-us2.pusher.com/app/32cbd69e4b950bf97679?protocol=7&client=js&version=8.4.0&flash=false

# Optional: Kick's webhook public key (PEM). Fetched from the API if unset.
# KICK_PUBLIC_KEY=
